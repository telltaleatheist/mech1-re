# A new campaign to an accepted contract. Each @snap records the screen the
# game then waits on. Handler names: campaign_continuations.h.
@snap:title
Return   @snap:arrival        # the arrival message over the hub
Return   @snap:hub            # the planet hub
Return   @snap:company        # row 0 COMPANY_MENU
Up       @snap:company_done   # row 2 PLANET_HUB
Return   @snap:hub_again
Down     @snap:office_1
Down     @snap:office_2       # row 2 CONTRACT_OFFICE
Return   @snap:office
Return   @snap:offer          # row 0 REQUEST_MISSION_OFFER
Left     @snap:negotiate_sel  # row 1 -> row 0 NEGOTIATE_CONTRACT
Return   @snap:accepted       # the hub, contract active
